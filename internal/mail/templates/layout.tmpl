{{/* The HTML of every message: its body on a plain page. */}}
{{define "layout"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Subject}}</title>
</head>
<body style="margin:0;padding:24px;background:#ffffff;color:#171717;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6">
<div style="max-width:560px;margin:0 auto">
<p style="margin:0 0 24px;font-weight:600;font-size:17px">Changeport</p>
{{.Body}}
</div>
</body>
</html>
{{end}}
