# Build output and pinned tool downloads
/bin/
# What go build ./cmd/<name> leaves in the repository root
/agent
/console
/devuser
/eksimages
/hostgateway
/provisioner

# Downloaded and checksum-verified from deploy/upstream-files.txt
/deploy/base/*/upstream/

# The kind overlay with the locally built images, written by hack/lib.sh
/deploy/overlays/kind-local/

# What hack/diagnostics.sh and failed CDC tests keep for CI to upload
/diagnostics/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# An account's inputs; terraform.tfvars.example lists them without values.
terraform.tfvars
# Written by hack/terraform.sh bootstrap while the state is still local.
backend_override.tf
crash.log

# Local secrets, such as the Clerk keys for the console; .env.sample lists
# the variables without values.
.env
.env.*
!.env.sample

# The web app's build, copied in for go build -tags embedui
/internal/console/ui/dist/
